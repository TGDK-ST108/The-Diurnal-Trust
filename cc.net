public sealed class VersionedRecord
{
    public string EntityId { get; set; } = "";
    public long Version { get; set; }
    public string PayloadJson { get; set; } = "{}";
    public string PayloadHash { get; set; } = "";
    public bool LockedForReview { get; set; }
}

public sealed class OverwriteAuditEvent
{
    public string EventId { get; set; } = Guid.NewGuid().ToString("N");
    public string RequestId { get; set; } = "";
    public string Action { get; set; } = "";
    public DateTimeOffset Utc { get; set; } = DateTimeOffset.UtcNow;
    public string PrevHash { get; set; } = "";
    public string EventHash { get; set; } = "";
    public string DataJson { get; set; } = "{}";
}

public static class LedgerHash
{
    public static string Sha256Hex(string input)
    {
        using var sha = SHA256.Create();
        return Convert.ToHexString(sha.ComputeHash(Encoding.UTF8.GetBytes(input))).ToLowerInvariant();
    }
}
