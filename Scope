from dataclasses import dataclass, field
from typing import Optional, Dict, List
import hashlib
import json
import time


@dataclass
class TrajectoryPacket:
    id: str
    timestamp: float = field(default_factory=time.time)
    source_frame: str = "simulation"
    bridge_stage: int = 1
    realm_state: Dict[str, float] = field(default_factory=dict)
    vector_position: List[float] = field(default_factory=lambda: [0.0, 0.0])
    vector_direction: List[float] = field(default_factory=lambda: [0.0, 0.0])
    confidence: float = 0.5
    lattice_node: Optional[str] = None
    error_trace: Optional[str] = None
    verification_hash: Optional[str] = None

    def __post_init__(self):
        self.verification_hash = self._generate_hash()

    def _generate_hash(self) -> str:
        payload = {
            "id": self.id,
            "timestamp": self.timestamp,
            "stage": self.bridge_stage,
            "realm_state": self.realm_state,
            "vector_position": self.vector_position,
            "vector_direction": self.vector_direction,
            "confidence": self.confidence,
            "lattice_node": self.lattice_node,
            "error_trace": self.error_trace,
        }
        packet_str = json.dumps(payload, sort_keys=True).encode("utf-8")
        return hashlib.sha256(packet_str).hexdigest()

    def update_stage(self, stage: int, realm_state: Dict[str, float], confidence: float):
        self.bridge_stage = stage
        self.realm_state.update(realm_state)
        self.confidence = confidence
        self.verification_hash = self._generate_hash()

    def advance_position(self, dt: float = 1.0):
        self.vector_position = [
            self.vector_position[0] + self.vector_direction[0] * dt,
            self.vector_position[1] + self.vector_direction[1] * dt,
        ]
        self.verification_hash = self._generate_hash()


