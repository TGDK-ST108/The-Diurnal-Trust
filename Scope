from typing import Dict


class RealmOverlay:
    def __init__(self):
        self.realms = {
            "potential": 0.0,
            "alignment": 0.0,
            "clarity": 0.0,
            "focus": 0.0,
            "precision": 0.0,
            "convergence": 0.0,
            "resolution": 0.0,
            "release": 0.0,
            "transcendence": 0.0,
        }

    def update_realms(self, realm_state: Dict[str, float]) -> None:
        for realm, score in realm_state.items():
            if realm in self.realms:
                self.realms[realm] = score

    def check_realm_conditions(self, threshold: float = 0.7) -> bool:
        populated = [score for score in self.realms.values() if score > 0.0]
        if not populated:
            return False
        return all(score >= threshold for score in populated)

    def snapshot(self) -> Dict[str, float]:
        return dict(self.realms)


